      <a href="{{ '/assets/logo/mark-orange.svg' | url }}" download><img src="{{ '/assets/logo/mark-orange.svg' | url }}" alt="">على خلفية فاتحة (SVG)</a>
      <a class="on-dark" href="{{ '/assets/logo/mark-white.svg' | url }}" download><img src="{{ '/assets/logo/mark-white.svg' | url }}" alt="">على خلفية داكنة (SVG)</a>
      <a href="{{ '/assets/logo/icon-1024.png' | url }}" download><img src="{{ '/assets/logo/icon-1024.png' | url }}" alt="">أيقونة التطبيق (PNG، ‏1024 بكسل)</a>
