---
permalink: /assets/css/dev.css
eleventyExcludeFromCollections: true
---
{% include "css/font-faces-dev.css" %}
/* dev pages only (/dev/): specimen and component page helpers */
.dev-head { padding-block: var(--s7) var(--s5); border-block-end: 1px solid var(--hairline); }
.dev-head p { color: var(--ink-2); }
.dev-section { padding-block: var(--s7); border-block-end: 1px solid var(--hairline); }
.dev-section > h2 { font-size: 15px; letter-spacing: .04em; text-transform: uppercase; color: var(--ink-2); margin-block-end: var(--s2); font-family: var(--font-body); }
.dev-section > .dev-note { font-size: 14px; color: var(--ink-2); margin-block-end: var(--s5); max-inline-size: 80ch; }
.dev-pair { display: grid; gap: var(--s5); }
@media (min-width: 1024px) { .dev-pair { grid-template-columns: 1fr 1fr; } }
.dev-pane { padding: var(--s5); border-radius: var(--r-card); background: var(--paper); color: var(--ink); box-shadow: 0 0 0 1px var(--hairline); min-inline-size: 0; }
.dev-pane__tag { font: 600 12px/1 var(--font-body); color: var(--ink-2); text-transform: uppercase; letter-spacing: .06em; margin-block-end: var(--s4); }
.dev-swatches { display: grid; gap: var(--s3); grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
.dev-swatch { border-radius: 14px; overflow: hidden; box-shadow: 0 0 0 1px var(--hairline); background: var(--surface); }
.dev-swatch__chip { block-size: 56px; }
.dev-swatch__text { padding: 8px 10px; font-size: 12px; line-height: 1.4; }
.spec { display: grid; gap: var(--s5); }
.spec__row { display: grid; gap: var(--s3); padding: var(--s5); border-radius: var(--r-card); background: var(--surface); box-shadow: 0 0 0 1px var(--hairline); }
.spec__name { font: 600 13px/1.3 var(--font-body); color: var(--ink-2); }
.spec__name b { color: var(--ink); }
.f-system { --font-head: ui-rounded, "SF Pro Rounded", var(--font-body); } /* Chrome on a Mac with the SF fonts installed also shows SF Pro Rounded by name */
.f-nunito { --font-head: "Nunito", var(--font-body); }
.f-mplus { --font-head: "M PLUS Rounded 1c", var(--font-body); }
.f-rubik { --font-head: "Rubik", var(--font-body); }
.f-ar-system { --font-head: ui-rounded, "SF Arabic Rounded", -apple-system, "SF Arabic", sans-serif; }
.f-ar-rubik { --font-head: "Rubik", sans-serif; }
.f-ar-readex { --font-head: "Readex Pro", sans-serif; }
.f-ar-body-system { --font-body: -apple-system, "SF Arabic", sans-serif; }
.f-ar-body-plex { --font-body: "IBM Plex Sans Arabic", sans-serif; }
.spec h1, .spec h2, .spec h3, .spec .num { font-family: var(--font-head); }
.spec .body-sample { font-family: var(--font-body); }
.f-mplus h1, .f-mplus h2, .f-mplus .num { font-weight: 800; }
.f-rubik h1, .f-rubik h2, .f-rubik .num { font-weight: 700; }
.f-rubik h3 { font-weight: 600; }
.spec-detect { font-size: 13px; padding: 10px 14px; border-radius: 12px; background: var(--sand); }
