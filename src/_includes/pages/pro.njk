{#- InEgypt Pro page, English and Arabic. Dark page: wordmark, two plans, one comparison table.
    Copy: _data/pro/<lang>.json. Rows mirror the app's What's Included table; prices come from facts.json through fillFacts. -#}
{%- set p = pro[lang] -%}
{%- set ct = "web_ar_pro_" if lang == "ar" else "web_pro_" -%}
{%- macro mark(inc, isPro) -%}
<td>{% if inc %}<span class="pro-tick{% if isPro %} pro-tick--pro{% endif %}">{% icon "check-circle-fill" %}</span><span class="visually-hidden">{{ p.included }}</span>{% else %}<span class="pro-cross">{% icon "x" %}</span><span class="visually-hidden">{{ p.notIncluded }}</span>{% endif %}</td>
{%- endmacro -%}

<section class="pro-hero" aria-labelledby="pro-title">
  <p class="pro-wordmark" dir="ltr" aria-label="InEgypt Pro"><span aria-hidden="true">InEgypt</span> <span class="pro-badge" aria-hidden="true">PRO</span></p>
  <h1 id="pro-title" data-reveal>{{ p.h1 }}</h1>
  <p class="pro-hero__lead" data-reveal style="--i: 1">{{ p.lead }}</p>
</section>

<section class="pro-section" aria-labelledby="plans-title">
  <div class="pro-plans__head">
    <h2 id="plans-title" class="pro-section__title">{{ p.plansTitle }}</h2>
    {#- The switch appears only with the script; without it both groups show, each under its own label. -#}
    <div class="pro-switch" role="tablist" aria-label="{{ p.groupsLabel }}" data-tabs hidden>
      {%- for g in p.groups %}
      <button type="button" role="tab" id="tab-{{ g.id }}" aria-controls="panel-{{ g.id }}" aria-selected="{{ 'true' if loop.first else 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %}>{{ g.label }}</button>
      {%- endfor %}
    </div>
  </div>
  {%- for g in p.groups %}
  <div class="pro-panel" role="tabpanel" id="panel-{{ g.id }}" aria-labelledby="tab-{{ g.id }}">
  <h3 class="pro-panel__label">{{ g.label }}</h3>
  <div class="pro-plans">
    {%- for pl in g.plans %}
    <article class="pro-plan{% if pl.flag %} pro-plan--best{% endif %}" data-reveal style="--i: {{ loop.index0 }}">
      <div class="pro-plan__top">
        <h3 class="pro-plan__name">{{ pl.name }}</h3>
        <span class="pro-badge" aria-hidden="true">PRO</span>
      </div>
      {%- if pl.flag %}<p class="pro-plan__flag">{{ pl.flag }}</p>{% endif %}
      <p class="pro-plan__price"><span class="num" dir="ltr">{{ pl.price | fillFacts }}</span> <span class="pro-plan__unit">{{ pl.unit }}</span></p>
      <p class="pro-plan__note">{{ pl.note }}</p>
    </article>
    {%- endfor %}
  </div>
  </div>
  {%- endfor %}
  <a class="btn pro-cta" href="{{ (ct + 'cta') | appLink }}">{% icon "arrow-circle-down-fill" %}{{ p.cta }}</a>
  <p class="pro-note">{{ p.priceNote }}</p>
</section>

<section class="pro-section" aria-labelledby="compare-title">
  <table class="pro-table">
    <caption class="visually-hidden">{{ p.compareTitle }}</caption>
    <thead>
      <tr>
        <th scope="col"><span id="compare-title" class="pro-table__title">{{ p.compareTitle }}</span></th>
        <th scope="col">{{ p.free }}</th>
        <th scope="col"><span class="pro-badge">PRO</span><span class="visually-hidden"> (Pro)</span></th>
      </tr>
    </thead>
    <tbody>
      {%- for r in p.shared %}
      <tr><th scope="row">{{ r[0] }}</th>{{ mark(true, false) }}{{ mark(true, true) }}</tr>
      {%- endfor %}
      {%- for r in p.pro %}
      <tr class="pro-table__pro"><th scope="row">{{ r[0] }}{% if r[1] %}<span class="pro-table__sub">{{ r[1] }}</span>{% endif %}</th>{{ mark(false, false) }}{{ mark(true, true) }}</tr>
      {%- endfor %}
    </tbody>
  </table>
  <p class="pro-note">{{ p.offlineNote }}</p>
</section>
