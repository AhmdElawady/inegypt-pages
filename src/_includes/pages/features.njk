{#- Features page, English and Arabic. Copy: _data/features/<lang>.json (same ids, screens and tags in both). -#}
{%- from "components/media.njk" import device with context -%}
{%- from "components/calls.njk" import inlineCall with context -%}
{%- set fx = features[lang] -%}
{%- set L = fx.labels -%}
{%- set ct = "web_ar_features" if lang == "ar" else "web_features" -%}
<section class="section" style="padding-block-end: 0">
  <div class="container stack" style="max-inline-size: 860px">
    <h1 style="font-size: var(--fs-h2)">{{ fx.h1 }}</h1>
    <p class="lead">{{ fx.lead }}</p>
    <ul class="modes" aria-label="{{ L.sections }}">{% for g in fx.groups %}<li><span class="dot" style="--c: var(--{{ g.line }})" aria-hidden="true"></span><a href="#{{ g.line }}" style="color: inherit; text-decoration: none">{{ g.title }}</a></li>{% endfor %}</ul>
  </div>
</section>
{%- for g in fx.groups %}
<section class="section has-line line-{{ g.line }}" id="{{ g.line }}" style="--line: var(--{{ g.line }})" aria-labelledby="h-{{ g.line }}">
  <div class="container stack-lg">
    <h2 id="h-{{ g.line }}">{{ g.title }}</h2>
    {%- for it in g.items %}
    <article class="feature-row" id="{{ it.id | lower }}">
      <div class="stack">
        <p><span class="chip {{ 'chip--free' if it.tag == 'Free' else 'chip--pro' }}">{{ L.free if it.tag == "Free" else (L.pro if it.tag == "Pro" else L.mixed) }}</span></p>
        <h3>{{ it.name }}</h3>
        <p class="lead" style="color: var(--ink)">{{ it.benefit }}</p>
        <p>{{ it.detail | fillFacts }}</p>
        {%- if it.phrases %}
        {%- if L.phrasesNote %}<p class="small muted">{{ L.phrasesNote }}</p>{% endif %}
        {%- set phrases = facts.iphoneFeatures.siriPhrases.valueAr if (lang == "ar" and facts.iphoneFeatures.siriPhrases.valueAr) else facts.iphoneFeatures.siriPhrases.value %}
        <ul class="small">{% for p in phrases %}<li>{{ "«" + p + "»" if lang == "ar" else "“" + p + "”" }}</li>{% endfor %}</ul>
        {%- endif %}
        {%- if it.limit %}<p class="small muted"><b>{{ L.limit }}</b> {{ it.limit }}</p>{% endif %}
      </div>
      <div class="feature-row__media">
        {%- if it.screen %}{{ device(it.screen, it.name + L.inAppSuffix, 210) }}{% endif %}
      </div>
    </article>
    {%- endfor %}
  </div>
</section>
{%- endfor %}
<div class="container">{{ inlineCall(ct, L.inline, lang) }}</div>
