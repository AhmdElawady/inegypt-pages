{#- The home page, planner first: the trip plan, then where to go, how to get between cities, what things cost
    and how to stay safe; then who makes it, what is free, and how to get it. Same order in English and Arabic
    (owner, 2026-11-17: Arab visitors are travellers too). Copy: _data/home/<lang>.json. Numbers: facts.json and atoms.json.
    Station signs (Arabic over English) label each place, as on Egyptian platforms. -#}
{%- from "components/signs.njk" import sign with context -%}
{%- from "components/media.njk" import picture, ribbon with context -%}
{%- from "components/content.njk" import ticket with context -%}
{%- from "components/calls.njk" import cta with context -%}
{%- set h = home[lang] -%}
{%- set arabic = lang == "ar" -%}
{%- set ct = "web_ar_home_" if arabic else "web_home_" -%}
{%- set cov = facts.coverage -%}
{%- set proofValues = {
  attractions: '<bdi dir="ltr">' + cov.attractions.display + '</bdi>',
  cities: '<bdi>' + cov.cities.display + '</bdi>',
  routes: '<bdi>' + cov.routes.value + '</bdi>',
  stops: '<span class="proof__prefix">' + h.proof.nearly + '</span> <bdi>' + (cov.stops.display | replace("nearly ", "")) + '</bdi>',
  modes: '<bdi>' + cov.transitModes.value + '</bdi>'
} -%}

<section class="platform platform--trip" aria-labelledby="home-title">
  <div class="platform__scene">{{ picture("photos/P19", h.hero.photoAlt, "100vw", "high") }}</div>
  <div class="platform__inner">
    <div class="platform__copy">
      {{ sign(h.hero.sign[0], h.hero.sign[1], "plan", lang) }}
      <h1 id="home-title">{{ h.hero.h1 }}</h1>
      <p class="platform__lead">{{ h.hero.lead }}</p>
      {{ cta(ct + "hero", h.hero.underBadge, lang, ct + "hero_qr") }}
    </div>
    <div class="hero-stage">
    <div class="platform__screen">
      {% if arabic %}<img class="platform__sheet" src="{{ '/assets/img/journey/alexandria-day-ar.webp' | url }}" width="720" height="829" alt="{{ h.hero.screenAlt }}">
      {% else %}{{ picture("screens/s03c-trip-map-light-framed", h.hero.screenAlt, "(max-width: 639px) 280px, 320px", "eager") }}{% endif %}
    </div>
    {#- Floating cards around the phone (calm pass step 4). Real data only, all repeated further down the page, so hidden from screen readers. -#}
    {%- set taxi = atoms.atoms.price_airport_taxi %}{% set place = h.discover.ribbon[0] %}
    <div class="hero-cards" aria-hidden="true">
      {%- if taxi and taxi.siteUsable %}
      <div class="hero-card hero-card--price" data-reveal style="--i: 2">
        <span class="hero-card__label">{{ taxi[lang].title }}</span>
        <span class="hero-card__value num" dir="ltr"><bdi>{{ taxi.min }}–{{ taxi.max }}</bdi> <small>{{ taxi.currency }}</small></span>
        <span class="hero-card__meta">{{ strings[lang].checked }} <bdi>{{ taxi.lastVerifiedAt | monthYear(lang) }}</bdi></span>
      </div>
      {%- endif %}
      <div class="hero-card hero-card--routes" data-reveal style="--i: 3">
        <span class="hero-card__value num"><bdi>{{ cov.routes.value }}</bdi></span>
        <span class="hero-card__label">{{ h.proof.routes }}</span>
        <span class="hero-card__dots">{% for m in h.train.modes %}<span class="dot" style="--c: var(--{{ m[1] }})"></span>{% endfor %}</span>
      </div>
      <div class="hero-card hero-card--place" data-reveal style="--i: 4">
        {{ picture(place.key, "", "64px", "eager", "hero-card__thumb") }}
        {{ sign(place.en, place.ar, "nile", lang) }}
      </div>
    </div>
    </div>
  </div>
</section>

{#- Proof bar: what is in the app, counted from its data. Places and cities first. -#}
<section class="proof" aria-label="{{ h.proof.label }}">
  <dl class="proof__list">
    {%- for k in h.proof.order %}
    <div><dt>{{ h.proof[k] }}</dt><dd class="num">{{ proofValues[k] | safe }}</dd></div>
    {%- endfor %}
  </dl>
</section>

{#- PLAN: the heart of the app -#}
<section class="journey-plan" id="plan" aria-labelledby="plan-title">
  <div class="journey-grid">
    <div class="journey-text" data-reveal>
      {{ sign(h.plan.sign[0], h.plan.sign[1], "plan", lang) }}
      <h2 id="plan-title">{{ h.plan.title }}</h2>
      <p>{{ h.plan.body }}</p>
      <a class="journey-link" href="{{ h.plan.href | url }}">{{ h.plan.link }} <span aria-hidden="true">→</span></a>
    </div>
    <figure class="day-photo{% if arabic %} day-photo--plain{% endif %}" data-reveal style="--i: 1">
      {{ picture("photos/P06" if arabic else "photos/P02", h.plan.photoAlt, "(max-width: 700px) 100vw, 600px") }}
      <figcaption>{{ h.plan.caption }}</figcaption>
      {%- if not arabic %}
      <div class="day-photo__screen">{{ picture("screens/s03b-itinerary-light-framed", h.plan.screenAlt, "(max-width: 639px) 235px, 290px") }}</div>
      {%- endif %}
    </figure>
  </div>
  <div class="journey-wide plan-more">
    <ol class="plan-steps" aria-label="{{ h.plan.stepsLabel }}">
      {%- for st in h.plan.steps %}
      <li data-reveal style="--i: {{ loop.index0 }}"><span class="plan-steps__icon" aria-hidden="true">{% icon st[0] %}</span><h3>{{ st[1] }}</h3><p>{{ st[2] }}</p></li>
      {%- endfor %}
    </ol>
    <div class="strip-line" data-reveal>
      <div class="strip-line__track" aria-hidden="true">
        {%- for st in h.plan.strip.stops %}
        <div class="strip-line__stop"><span class="art">{{ art[st[2]] | safe }}</span>{{ sign(st[0], st[1], "plan", lang) }}</div>
        {%- endfor %}
      </div>
      <p class="strip-line__caption">{{ h.plan.strip.caption }}</p>
    </div>
    <aside class="paste-note" data-reveal>
      <span class="paste-note__icon" aria-hidden="true">{% icon "clipboard-text" %}</span>
      <div><p class="paste-note__title">{{ h.plan.paste.title }}</p><p>{{ h.plan.paste.text }}</p></div>
    </aside>
  </div>
</section>

<section class="journey-discover" id="discover" aria-labelledby="discover-title">
  <div class="journey-wide">
    <div class="journey-text journey-text--wide" data-reveal>
      {{ sign(h.discover.sign[0], h.discover.sign[1], "nile", lang) }}
      <h2 id="discover-title"><bdi dir="ltr">{{ facts.coverage.attractions.display }}</bdi> {{ h.discover.h2a }} <bdi>{{ facts.coverage.cities.display }}</bdi> {{ h.discover.h2b }}</h2>
      <p>{{ h.discover.body }}</p>
    </div>
    <div data-reveal style="--i: 1">{{ ribbon("discover-ribbon", h.discover.ribbonLabel, h.discover.ribbon, lang) }}</div>
  </div>
</section>

{%- set arrival %}
<section class="journey-step journey-step--arrival" id="prices" aria-labelledby="arrival-title">
  <div class="journey-grid">
    <div class="journey-text" data-reveal>
      {{ sign(h.price.sign[0], h.price.sign[1], "price", lang) }}
      <h2 id="arrival-title">{{ h.price.title }}</h2>
      <p>{{ h.price.body }}</p>
      <a class="journey-link" href="{{ h.price.href | url }}">{{ h.price.link }} <span aria-hidden="true">→</span></a>
    </div>
    <div class="arrival-ticket" data-reveal style="--i: 1">
      {{ ticket("price_airport_taxi", lang) }}
      <div class="price-rows">
        <p class="price-rows__label">{{ h.price.others }}</p>
        <ul>
          {%- for id in facts.knowledge.priceTicketAtoms.value %}{% set a = atoms.atoms[id] %}
          {%- if id != "price_airport_taxi" and a and a.siteUsable %}
          <li><span>{{ a[lang].title }}</span><span class="price-rows__value num" dir="ltr"><bdi>{{ a.min }}–{{ a.max }}</bdi> <small>{{ a.currency }}</small></span><span class="price-rows__date"><bdi>{{ a.lastVerifiedAt | monthYear(lang) }}</bdi></span></li>
          {%- endif %}{% endfor %}
        </ul>
        {%- if h.price.fullList.guide in guides.live %}
        <a class="journey-link" href="{{ h.price.fullList.href | url }}">{{ h.price.fullList.text }} <span aria-hidden="true">→</span></a>
        {%- endif %}
      </div>
    </div>
  </div>
</section>
{%- endset %}
{%- set rail %}
<section class="journey-step journey-step--rail" id="routes" aria-labelledby="rail-title">
  <div class="journey-grid">
    <div class="journey-text" data-reveal>
      {{ sign(h.train.sign[0], h.train.sign[1], "route", lang) }}
      <h2 id="rail-title">{{ h.train.title }}</h2>
      <p>{{ h.train.body }}</p>
      <ul class="modes" aria-label="{{ h.train.modesLabel }}">{% for m in h.train.modes %}<li><span class="dot" style="--c: var(--{{ m[1] }})" aria-hidden="true"></span>{{ m[0] }}</li>{% endfor %}</ul>
      <p class="journey-note">{{ h.train.honest }}</p>
      <a class="journey-link" href="{{ h.train.href | url }}">{{ h.train.link }} <span aria-hidden="true">→</span></a>
    </div>
    <div class="rail-photo" data-reveal style="--i: 1">
      {{ picture("photos/P14", "", "(max-width: 700px) 100vw, 600px") }}
      <img class="rail-table" src="{{ ('/assets/img/journey/timetable-' + lang + '.webp') | url }}" width="720" height="{{ 716 if arabic else 697 }}" loading="lazy" alt="{{ h.train.alt }}">
    </div>
  </div>
</section>
{%- endset %}
{{ rail | safe }}
{{ arrival | safe }}

<section class="journey-step journey-step--safe" id="safety" aria-labelledby="safety-title">
  <div class="journey-grid">
    <div class="journey-text" data-reveal>
      {{ sign(h.safety.sign[0], h.safety.sign[1], "safe", lang) }}
      <h2 id="safety-title">{{ h.safety.title }}</h2>
      <p>{{ h.safety.body }}</p>
      <a class="journey-link" href="{{ h.safety.href | url }}">{{ h.safety.link }} <span aria-hidden="true">→</span></a>
    </div>
    <div class="safe-phones" data-reveal style="--i: 1">
      {{ picture("screens/s11-emergency-light-framed", h.safety.emergencyAlt, "(max-width: 700px) 46vw, 250px") }}
      {{ picture("screens/s10-tips-light-framed", h.safety.tipsAlt, "(max-width: 700px) 46vw, 250px") }}
    </div>
  </div>
</section>

<section class="journey-maker" id="maker" aria-labelledby="maker-title">
  <div class="journey-grid">
    <div class="journey-text" data-reveal>
      <h2 id="maker-title">{{ h.maker.title }}</h2>
      <p>{{ h.maker.note }}</p>
      <p class="maker-signature">{{ h.maker.signature }}</p>
      <a class="journey-link" href="{{ h.maker.href | url }}">{{ h.maker.link }} <span aria-hidden="true">→</span></a>
    </div>
    <div class="traveller-review" data-reveal style="--i: 1">
      <figure lang="en" dir="ltr">
        <blockquote>“{{ h.maker.review.text }}”</blockquote>
        <figcaption>{{ h.maker.review.who }} · {{ h.maker.review.store }} · {{ h.maker.review.date }}</figcaption>
      </figure>
      <ul class="more-reviews" lang="en" dir="ltr">
        {%- for r in h.maker.more %}
        <li><figure><blockquote>“{{ r.text }}”</blockquote><figcaption>{{ r.who }} · {{ r.store }} · {{ r.date }}</figcaption></figure></li>
        {%- endfor %}
      </ul>
      {%- if h.maker.reviewsNote %}<p class="journey-note">{{ h.maker.reviewsNote }}</p>{% endif %}
      <a class="journey-link" href="{{ (ct + 'reviews') | appLink }}">{{ h.maker.reviewsLink }} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<section class="journey-plans" id="free-paid" aria-labelledby="plans-title">
  <div class="journey-wide">
    <h2 id="plans-title" data-reveal>{{ h.plans.title }}</h2>
    <div class="plan-cards">
      <article class="plan-card" data-reveal>
        <h3>{{ h.plans.free }}</h3>
        <ul>{% for item in (h.plans.freeItems or facts.free.value) %}<li>{% icon "check" %}<span>{{ item }}</span></li>{% endfor %}</ul>
      </article>
      <article class="plan-card plan-card--pro" data-reveal style="--i: 1">
        <h3>{{ h.plans.pro }}</h3>
        <p class="plan-card__price">{{ h.plans.proLine | fillFacts }}</p>
        <p class="plan-card__lead">{{ h.plans.proLead }}</p>
        <ul>{% for item in (h.plans.proItems or facts.paid.value) %}<li>{% icon "sparkle" %}<span>{{ item }}</span></li>{% endfor %}</ul>
        <p class="journey-note">{{ h.plans.currency }}</p>
      </article>
    </div>
    <a class="journey-link" href="{{ h.plans.featuresHref | url }}">{{ h.plans.features }} <span aria-hidden="true">→</span></a>
  </div>
</section>

<section class="journey-install" aria-labelledby="install-title">
  <div class="journey-grid" id="get">
    <div class="journey-text" data-reveal>
      <h2 id="install-title">{{ h.install.title }}</h2>
      <p>{{ h.install.free }}</p>
      {{ cta(ct + "final", h.hero.underBadge, lang, ct + "final_qr") }}
    </div>
    <div class="journey-text install-pro" data-reveal style="--i: 1">
      <h3>{{ h.install.iphone.title }}</h3>
      <ul class="install-list">{% for it in h.install.iphone.items %}<li>{% icon it[0] %}<span>{{ it[1] }}</span></li>{% endfor %}</ul>
    </div>
  </div>
</section>

<section class="journey-faq" id="faq" aria-labelledby="faq-title">
  <div class="journey-wide">
    <h2 id="faq-title" data-reveal>{{ h.faq.h2 }}</h2>
    <div class="faq faq--cols">
      {%- for it in h.faq.items %}
      <details data-reveal style="--i: {{ loop.index0 % 2 }}"><summary><h3>{{ it.q }}</h3>{% icon "caret-down" %}</summary><p>{{ it.a | fillFacts }}{% if it.link %} <a href="{{ it.link.href | url }}">{{ it.link.text }}</a>{% endif %}</p></details>
      {%- endfor %}
    </div>
  </div>
</section>
