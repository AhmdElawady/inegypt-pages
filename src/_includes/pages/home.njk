{# Home copy is localized in _data/home. Coverage, fares and subscription prices come from the signed data. #}
{%- from "components/media.njk" import picture with context -%}
{%- from "components/content.njk" import ticket with context -%}
{%- from "components/calls.njk" import cta with context -%}
{%- set h = home[lang] -%}
{%- set arabic = lang == "ar" -%}
{%- set ct = "web_ar_home_" if arabic else "web_home_" -%}
{%- set cov = facts.coverage -%}
{%- set proofValues = {
  attractions: '<bdi dir="ltr">' + cov.attractions.display + '</bdi>',
  cities: '<bdi>' + cov.cities.display + '</bdi>',
  routes: '<bdi>' + cov.routes.value + '</bdi>',
  stops: '<span class="proof__prefix">' + h.proof.nearly + '</span> <bdi>' + (cov.stops.display | replace("nearly ", "")) + '</bdi>',
  modes: '<bdi>' + cov.transitModes.value + '</bdi>'
} -%}

{% macro textLink(href, label) -%}
<a class="journey-link" href="{{ href }}">{{ label }} <span aria-hidden="true">→</span></a>
{%- endmacro %}

<section class="platform" aria-labelledby="home-title">
  <div class="platform__scene">{{ picture("photos/P19", h.hero.photoAlt, "100vw", "high") }}</div>
  <div class="platform__inner">
    <div class="platform__copy">
      <h1 id="home-title">{% for phrase in h.hero.h1 %}<span>{{ phrase }}</span>{% if not loop.last %} {% endif %}{% endfor %}</h1>
      <p class="platform__lead">{{ h.hero.lead }}</p>
      {{ cta(ct + "hero", h.hero.underBadge, lang) }}
    </div>
  </div>
</section>

{#- Proof bar: what is in the app, counted from its data. Places and cities first. -#}
<section class="proof" aria-label="{{ h.proof.label }}">
  <dl class="proof__list">
    {%- for k in h.proof.order %}
    <div><dt>{{ h.proof[k] }}</dt><dd class="num">{{ proofValues[k] | safe }}</dd></div>
    {%- endfor %}
  </dl>
</section>

{#- Trip day: the itinerary on a phone, with whole cards from the app floating around it. Cards on the start side tuck
    behind the phone, cards on the end side sit in front. On phones two cards stay. -#}
{%- set td = h.tripDay -%}
<section class="trip-stage" id="trip" aria-labelledby="trip-title">
  <div class="home-intro" data-reveal>
    <h2 id="trip-title">{{ td.title }}</h2>
    <p>{{ td.body }}</p>
  </div>
  <div class="trip-stage__scene">
    <div class="trip-stage__phone" data-reveal>{{ picture("screens/s03b-itinerary-light-framed", td.screenAlt, "(max-width: 760px) 58vw, 310px") }}</div>
    {%- for c in td.cards %}
    <div class="trip-card trip-card--{{ c.slot }}" data-reveal style="--i: {{ loop.index }}">{{ picture("cards/" + c.key, c.alt, "(max-width: 760px) 46vw, 300px") }}</div>
    {%- endfor %}
  </div>
  <p class="trip-stage__note journey-note">{{ td.proNote }}</p>
</section>

{#- Each section below follows one pattern: a centred heading with one line, then one large visual. -#}
<section class="journey-plan" id="plan" aria-labelledby="plan-title">
  <div class="home-intro" data-reveal>
    <h2 id="plan-title">{{ h.plan.title }}</h2>
    <p>{{ h.plan.body }}</p>
    {{ textLink(h.plan.href | url, h.plan.link) }}
  </div>
  <figure class="day-photo" data-reveal style="--i: 1">
    {{ picture("photos/P06" if arabic else "photos/P02", h.plan.photoAlt, "(max-width: 760px) 95vw, 1100px") }}
    <div class="day-photo__screen">
      {% if arabic %}
      <img src="{{ '/assets/img/journey/alexandria-day-ar.webp' | url }}" width="720" height="829" alt="{{ h.plan.screenAlt }}" loading="lazy" decoding="async">
      {% else %}
      {{ picture("screens/s03c-trip-map-light-framed", h.plan.screenAlt, "(max-width: 760px) 52vw, 290px") }}
      {% endif %}
    </div>
  </figure>
</section>

<section class="journey-discover" id="discover" aria-labelledby="discover-title">
  <div class="home-intro" data-reveal>
    <h2 id="discover-title">{{ h.discover.title }}</h2>
    <p>{{ h.discover.body }}</p>
  </div>
  <div class="journey-wide city-gallery">
    {% for city in h.discover.ribbon %}
    <figure data-reveal style="--i: {{ loop.index0 }}">
      {{ picture(city.key, city.alt, "(max-width: 600px) 46vw, 455px" if loop.first else "(max-width: 600px) 46vw, 320px") }}
      <figcaption class="city-label">{{ city.ar if arabic else city.en }}</figcaption>
    </figure>
    {% endfor %}
  </div>
</section>

{#- Cairo to Luxor: Ramses Station across the whole width, the question on the shaded side, and the app's own route
    results floating over the hall. A card is listed in home/<lang>.json and shows once its image is built. -#}
<section class="route-band" id="routes" aria-labelledby="rail-title">
  <div class="route-band__scene">{{ picture("photos/P14", "", "(max-width: 760px) 300vw, 100vw") }}</div>
  <div class="route-band__inner">
    <div class="journey-text route-band__text" data-reveal>
      <h2 id="rail-title">{{ h.train.title }}</h2>
      <p>{{ h.train.body }}</p>
      {{ textLink(h.train.href | url, h.train.link) }}
    </div>
    <ul class="route-band__cards" aria-label="{{ h.train.cardsLabel }}">
      {%- for c in h.train.cards %}{% if images["cards/" + c.key] %}
      <li class="route-card" data-reveal style="--i: {{ loop.index }}">{{ picture("cards/" + c.key, c.alt, "(max-width: 760px) 86vw, 380px") }}</li>
      {%- endif %}{% endfor %}
    </ul>
  </div>
</section>

<section class="home-price" id="prices" aria-labelledby="arrival-title">
  <div class="home-intro" data-reveal>
    <h2 id="arrival-title">{{ h.price.title }}</h2>
    <p>{{ h.price.body }}</p>
    {{ textLink(h.price.href | url, h.price.link) }}
  </div>
  <div class="arrival-ticket" data-reveal style="--i: 1">
    {{ ticket("price_airport_taxi", lang) }}
    {% if h.price.fullList.guide in guides.live %}{{ textLink(h.price.fullList.href | url, h.price.fullList.text) }}{% endif %}
  </div>
</section>

<section class="home-safety" id="safety" aria-labelledby="safety-title">
  <div class="home-intro" data-reveal>
    <h2 id="safety-title">{{ h.safety.title }}</h2>
    <p>{{ h.safety.body }}</p>
    {{ textLink(h.safety.href | url, h.safety.link) }}
  </div>
  <div class="safe-phones">
    <div data-reveal style="--i: 1">{{ picture("screens/s11-emergency-light-framed", h.safety.emergencyAlt, "(max-width: 760px) 44vw, 250px") }}</div>
    <div data-reveal style="--i: 2">{{ picture("screens/s10-tips-light-framed", h.safety.tipsAlt, "(max-width: 760px) 44vw, 250px") }}</div>
  </div>
</section>

<section class="journey-maker" id="maker" aria-labelledby="maker-title">
  <div class="home-intro" data-reveal>
    <h2 id="maker-title">{{ h.maker.title }}</h2>
    <p>{{ h.maker.note }}</p>
    <p class="maker-signature">{{ h.maker.signature }}</p>
    {{ textLink(h.maker.href | url, h.maker.link) }}
  </div>
</section>

{#- One traveller's words on their own, large; the rest stay one tap away. Reviews keep their language and attribution. -#}
<div class="home-review">
  <figure class="home-review__quote" lang="en" dir="ltr" data-reveal>
    <blockquote>“{{ h.maker.review.text }}”</blockquote>
    <figcaption>{{ h.maker.review.who }} · {{ h.maker.review.store }} · {{ h.maker.review.date }}</figcaption>
  </figure>
  <details class="review-details" data-reveal style="--i: 1">
    <summary>{{ h.maker.moreLabel }} {% icon "caret-down" %}</summary>
    <ul class="more-reviews" lang="en" dir="ltr">
      {%- for r in h.maker.more %}
      <li><figure><blockquote>“{{ r.text }}”</blockquote><figcaption>{{ r.who }} · {{ r.store }} · {{ r.date }}</figcaption></figure></li>
      {%- endfor %}
    </ul>
  </details>
  {%- if h.maker.reviewsNote %}<p class="journey-note">{{ h.maker.reviewsNote }}</p>{% endif %}
  {{ textLink((ct + "reviews") | appLink, h.maker.reviewsLink) }}
</div>

<section class="journey-plans" id="free-paid" aria-labelledby="plans-title">
  <div class="home-intro" data-reveal><h2 id="plans-title">{{ h.plans.title }}</h2></div>
  <div class="journey-wide plan-cards">
    <article class="plan-card" data-reveal style="--i: 1">
      <h3>{{ h.plans.free }}</h3>
      <ul>{% for item in h.plans.freeItems %}<li>{% icon "check" %}<span>{{ item }}</span></li>{% endfor %}</ul>
    </article>
    <article class="plan-card plan-card--pro" data-reveal style="--i: 2">
      <h3><bdi dir="ltr" lang="en">InEgypt <span class="pro-badge">PRO</span></bdi></h3>
      <p class="plan-card__lead">{{ h.plans.proLead }}</p>
      <ul>{% for item in h.plans.proItems %}<li>{% icon "check" %}<span>{{ item }}</span></li>{% endfor %}</ul>
      <div class="plan-card__cta">
        <p class="plan-card__price">{{ h.plans.proLine | fillFacts }}</p>
        <p class="journey-note">{{ h.plans.currency }}</p>
        <a class="btn" href="{{ h.plans.featuresHref | url }}">{{ h.plans.features }}</a>
      </div>
    </article>
  </div>
</section>

<section class="journey-faq" id="faq" aria-labelledby="faq-title">
  <div class="home-intro" data-reveal><h2 id="faq-title">{{ h.faq.h2 }}</h2></div>
  <div class="faq faq--cols">
    {%- for it in h.faq.items %}
    <details data-reveal style="--i: {{ loop.index0 + 1 }}"><summary><h3>{{ it.q }}</h3>{% icon "caret-down" %}</summary><p>{{ it.a | fillFacts }}{% if it.link %} <a href="{{ it.link.href | url }}">{{ it.link.text }}</a>{% endif %}</p></details>
    {%- endfor %}
  </div>
</section>

{#- Closing band: one centred call on a dark block that runs into the dark footer. -#}
<section class="journey-install" aria-labelledby="install-title">
  <div class="install-close" id="get">
    <img class="install-icon" src="{{ '/assets/logo/icon-512.png' | url }}" width="512" height="512" loading="lazy" alt="" data-reveal>
    <h2 id="install-title" data-reveal style="--i: 1">{{ h.install.title }}</h2>
    <p data-reveal style="--i: 2">{{ factsAr[facts.app.platforms.value] if arabic else facts.app.platforms.value }}<br>{{ h.install.siri }}</p>
    <div class="install-close__cta" data-reveal style="--i: 3">{{ cta(ct + "final", "", lang) }}</div>
  </div>
</section>
