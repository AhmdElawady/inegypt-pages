{%- from "components/calls.njk" import badgeLink -%}
{%- set home = "/ar/" if lang == "ar" else "/" -%}
<header class="nav">
  <div class="container container--wide nav__bar">
    <a class="nav__logo" href="{{ home | url }}" aria-label="InEgypt{{ ' — الرئيسية' if lang == 'ar' else ', home' }}">
      <img src="{{ '/assets/logo/mark-on-light.svg' | url }}" alt="" width="32" height="32">
      <span>InEgypt</span>
    </a>
    <nav class="nav__links" aria-label="{{ t.nav.menu }}">
      <a href="{{ '/features/' | url }}">{{ t.nav.features }}</a>
      <a href="{{ '/guides/' | url }}">{{ t.nav.guides }}</a>
      <a href="{{ (home + '#free-paid') | url }}">{{ t.nav.freePaid }}</a>
      <a href="{{ '/about/' | url }}">{{ t.nav.about }}</a>
    </nav>
    <div class="nav__end">
      <a class="nav__lang" href="{{ (langSwitchUrl or ('/' if lang == 'ar' else '/ar/')) | url }}" lang="{{ t.nav.langOtherCode }}" hreflang="{{ t.nav.langOtherCode }}">{{ t.nav.langOther }}</a>
      <a class="btn nav__get" href="{{ (navCt or 'web_home_nav') | appLink }}"><span class="nav__get-long">{{ t.nav.get }}</span><span class="nav__get-short">{{ t.nav.getShort }}</span></a>
      <details class="nav__menu">
        <summary aria-label="{{ t.nav.menu }}">{% icon "list" %}</summary>
        <nav class="nav__panel" aria-label="{{ t.nav.menu }}">
          <a href="{{ '/features/' | url }}">{{ t.nav.features }}</a>
          <a href="{{ '/guides/' | url }}">{{ t.nav.guides }}</a>
          <a href="{{ (home + '#free-paid') | url }}">{{ t.nav.freePaid }}</a>
          <a href="{{ '/about/' | url }}">{{ t.nav.about }}</a>
        </nav>
      </details>
    </div>
  </div>
</header>
