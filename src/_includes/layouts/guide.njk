---
layout: layouts/base.njk
---
{#- Guide page (Plan 46 §4.1, §4.4; Plan 47 §8.5 / P1 M6). Front matter: title (the question), description, ct, atomIds,
    related ([slug]), breadcrumb. "Last checked" = the newest checked date of the facts used = dateModified. -#}
{%- from "components/content.njk" import appbox, related as relatedCards with context -%}
{%- from "components/calls.njk" import shareRow with context -%}
{%- set ids = (atoms.atoms | priceGroups(priceGuideGroups, priceGuideExclude) | priceIds) if atomIdsFrom == "prices" else atomIds -%}
{%- set checked = ids | maxDate(atoms.atoms) -%}
{%- set ld = { "@context": "https://schema.org", "@graph": [
  { "@type": "Article", "headline": title, "description": description, "inLanguage": lang, "datePublished": checked, "dateModified": checked,
    "author": { "@type": "Person", "name": "Ahmed Elawady" }, "publisher": { "@type": "Organization", "name": "InEgypt" }, "mainEntityOfPage": page.url | absUrl },
  { "@type": "BreadcrumbList", "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "InEgypt", "item": "/" | absUrl },
    { "@type": "ListItem", "position": 2, "name": "Guides", "item": "/guides/" | absUrl },
    { "@type": "ListItem", "position": 3, "name": title, "item": page.url | absUrl } ] } ] } -%}
<script type="application/ld+json">{{ ld | json | safe }}</script>
<article class="section guide" style="padding-block-start: var(--s8)">
  <div class="container guide__body">
    <nav class="small muted" aria-label="Breadcrumb"><a href="{{ '/' | url }}">InEgypt</a> › <a href="{{ '/guides/' | url }}">Guides</a></nav>
    <header class="stack">
      <h1>{{ title }}</h1>
      <p class="answer__checked">{% icon "check-circle" %}<span>Last checked <time datetime="{{ checked }}">{{ checked | monthYear }}</time> · every fact below shows its own date and source</span></p>
    </header>
    {{ content | safe }}
    <h2>Related guides</h2>
    {{ relatedCards(related | relatedGuides(guideIndex)) }}
    {{ shareRow(page.url | url, "en") }}
  </div>
</article>
