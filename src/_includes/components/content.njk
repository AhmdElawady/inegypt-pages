{#- Content components: price ticket, app box, related links. -#}
{% from "components/calls.njk" import badgeLink with context %}


{#- Price ticket from a knowledge atom (Plan 46 §4.4): value, unit, checked date, estimate/official. -#}
{% macro ticket(id, lang="en") -%}
{%- set a = atoms.atoms[id] -%}
{%- set t = strings[lang] -%}
{%- if a and a.siteUsable -%}
<article class="ticket">
  <div class="ticket__label">{{ a[lang].title }}</div>
  <div class="ticket__value num" dir="ltr"><bdi>{{ a.min }}–{{ a.max }}</bdi> <span class="ticket__unit">{{ a.currency }}</span></div>
  <div class="ticket__tear" aria-hidden="true"></div>
  <div class="ticket__meta">
    <span>{{ t.checked }} <bdi>{{ a.lastVerifiedAt | monthYear(lang) }}</bdi></span>
    <span>{% if a.estimate %}{{ t.estimate }}{% else %}{% if a.source and a.source.url %}<a href="{{ a.source.url }}" rel="noopener">{{ t.official }}</a>{% else %}{{ t.official }}{% endif %}{% endif %}</span>
  </div>
</article>
{%- else -%}<!-- ticket {{ id }} not usable on the site (unpublished, no checked date or no number) -->{%- endif -%}
{%- endmacro %}

{#- App box for guides (P1 M6): what the app does for this task + badge + QR on desktop. -#}
{#- The App Store badge; the page's QR sits in the footer (bottom corner) on every page that has one. -#}
{% macro appbox(title, points, ct, compact=false, lang="en") -%}
<aside class="appbox{% if compact %} appbox--compact{% endif %}">
  <div class="stack"><h3>{{ title }}</h3>{% if points.length %}<ul>{% for p in points %}<li>{{ p }}</li>{% endfor %}</ul>{% endif %}</div>
  <div class="cta">{{ badgeLink(ct, lang, compact) }}</div>
</aside>
{%- endmacro %}

{#- items: [{ href, title, meta }] -#}
{% macro related(items) -%}
<div class="related">{% for it in items %}<a href="{{ it.href | url }}"{% if it.lang %} hreflang="{{ it.lang }}"{% endif %}><span class="related__title"{% if it.lang %} lang="{{ it.lang }}" dir="ltr"{% endif %}>{{ it.title }}</span><span class="related__meta">{{ it.meta }}</span></a>{% endfor %}</div>
{%- endmacro %}
