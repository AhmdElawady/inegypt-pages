{% from "components/signs.njk" import sign %}
{#- Media components: responsive picture, framed device, photo ribbon. -#}

{#- load: "lazy" (default, below the fold), "eager" (above the fold) or "high" (the one LCP image per page). -#}
{% macro picture(key, alt, sizes="100vw", load="lazy", cls="", fallbackWidth=null) -%}
{%- set im = images[key] -%}
{%- if not im -%}<!-- missing image {{ key }} -->{%- else -%}
{%- set fw = fallbackWidth or (im.widths[1] if im.widths.length > 1 else im.widths[0]) -%}
{%- set ffmt = "jpg" if "jpg" in im.formats else "webp" -%}
<picture{% if cls %} class="{{ cls }}"{% endif %}>
{%- for fmt in im.formats %}{% if fmt != "jpg" %}
  <source type="image/{{ fmt }}" sizes="{{ sizes }}" srcset="{% for w in im.widths %}{{ ('/assets/img/' + im.dir + '/' + im.base + '-' + w + '.' + fmt) | url }} {{ w }}w{% if not loop.last %}, {% endif %}{% endfor %}">
{%- endif %}{% endfor %}
  <img src="{{ ('/assets/img/' + im.dir + '/' + im.base + '-' + fw + '.' + ffmt) | url }}" width="{{ im.width }}" height="{{ im.height }}" alt="{{ alt }}"{% if load == "high" %} fetchpriority="high"{% elif load != "eager" %} loading="lazy"{% endif %} decoding="async">
</picture>
{%- endif -%}
{%- endmacro %}

{#- Device: the owner's framed export (D17) or, for a raw capture, the CSS fallback frame. -#}
{% macro device(key, alt, width=300) -%}
{%- set im = images[key] -%}
<figure class="device device--{{ 'framed' if (im and im.framed) else 'css' }}" style="--w: {{ width }}px">
  {{ picture(key, alt, "(max-width: 639px) 78vw, " + width + "px") }}
</figure>
{%- endmacro %}

{#- Swipeable row of photos with station-sign captions. items: [{ key, alt, en, ar, line }] -#}
{% macro ribbon(id, label, items, lang="en") -%}
<div class="ribbon" data-ribbon>
  <div class="ribbon__track" id="{{ id }}" tabindex="0" role="region" aria-label="{{ label }}">
    {%- for it in items %}
    <figure class="ribbon__card">
      {{ picture(it.key, it.alt, "(max-width: 639px) 72vw, 280px", "lazy", "photo") }}
      <figcaption>{{ sign(it.en, it.ar, it.line or "nile", lang) }}</figcaption>
    </figure>
    {%- endfor %}
  </div>
  <div class="ribbon__nav">
    <button type="button" data-dir="-1" aria-controls="{{ id }}" aria-label="{{ 'السابق' if lang == 'ar' else 'Previous' }}">{% icon "arrow-left" %}</button>
    <button type="button" data-dir="1" aria-controls="{{ id }}" aria-label="{{ 'التالي' if lang == 'ar' else 'Next' }}">{% icon "arrow-right" %}</button>
  </div>
</div>
{%- endmacro %}
