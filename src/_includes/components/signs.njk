{#- Station sign: dot + Arabic above English (G8). The language that only repeats the page language for
    sighted readers is aria-hidden, so a screen reader reads the sign once (§10.5). -#}
{% macro sign(en, ar, line="plan", lang="en") -%}
<span class="sign line-{{ line }}">
  <span class="sign__dot" aria-hidden="true"></span>
  <span class="sign__label">
    <span class="sign__first" lang="ar"{% if lang != "ar" %} aria-hidden="true"{% endif %}>{{ ar }}</span>
    <span class="sign__second" lang="en"{% if lang == "ar" %} aria-hidden="true"{% endif %}>{{ en }}</span>
  </span>
</span>
{%- endmacro %}
